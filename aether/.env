# CUSTOM
TZ=Asia/Shanghai

# 传输协议 masque (default) | wg | gool | mim
#AETHER_PROTOCOL=masque
# 扫描模式 turbo | balanced (default) | thorough | stealth | ironclad
#AETHER_SCAN=balanced
# 扫描 IP 版本 v4 (default) | v6 | both
#AETHER_IP=v4
# 混淆档 off | light | firewall | balanced | aggressive
#AETHER_NOIZE=
# SOCKS5 监听地址（容器内）；默认 0.0.0.0:1819，经 ports 映射控制暴露面
#AETHER_SOCKS=0.0.0.0:1819
# 额外的 HTTP CONNECT 代理地址（默认关闭）
#AETHER_HTTP_PROXY=
# 固定节点 ip:port，跳过扫描（端口必填）
#AETHER_PEER=
# 上游代理 URL，如 socks5://host:1080
#AETHER_UPSTREAM=
# 始终复用上次可用网关：1 | 0
#AETHER_QUICK_RECONNECT=
# 日志等级 error | warn | info (default) | debug | trace
#AETHER_LOG_LEVEL=info
