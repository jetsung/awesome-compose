# CUSTOM
TZ=Asia/Shanghai
SERV_PORT=18686

# UniDNS
# 凭据加密主密钥（64 位 hex = 32 字节），生成：
#   openssl rand -hex 32
# 留空则首次启动自动生成 data/secret.key（权限 0600）；两种方式都要随数据目录备份，
# 丢失后已保存的平台凭据无法解密，只能删除账户重新录入。
UNIDNS_MASTER_KEY=b34fde152208b3171b7d3a4b64672b32f03977549c7f057fc5eb0b605e99dc5b

# 预置管理员口令（仅首次设置口令时生效；忘记口令用 `unidns reset-password` 重置）
UNIDNS_ADMIN_PASSWORD=

# 定时全量同步间隔（分钟）；0 停用自动同步，启用时至少 30
# 仅为初始默认值，登录后在界面「同步设置」修改的优先
UNIDNS_SYNC_INTERVAL=0

# 日志级别（RUST_LOG 语法）
UNIDNS_LOG=info

# 容器内已默认监听 0.0.0.0:18686、数据目录 /app/data，通常无需设置：
# UNIDNS_LISTEN=0.0.0.0:18686
# UNIDNS_DATA_DIR=/app/data
