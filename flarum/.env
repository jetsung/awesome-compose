# CUSTOM
TZ=Asia/Shanghai

# 论坛访问地址（必填，写入 config.php）
FORUM_URL=https://forum.example.com

# 调试模式（生产环境保持 false）
DEBUG=false

# 不使用 GitHub 私有扩展 token（避免 startup 写入空 token 导致 github 认证失败）
GITHUB_TOKEN_AUTH=false

# 额外 PHP 扩展（aws-sdk 需要 simplexml）
PHP_EXTENSIONS=simplexml

# 数据库配置（mysql 栈，不在 sharenet 上，经宿主机 3306 端口访问）
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=flarum
DB_USER=root
# 占位符，部署时替换为 mysql 栈实际 root 密码
DB_PASS=<DB_PASS>
DB_PREF=bbs_

# 已有数据库，无需首次安装管理员变量
# 若是全新安装，需补充以下变量（密码至少 8 位）：
# FLARUM_ADMIN_USER=admin
# FLARUM_ADMIN_PASS=change_me
# FLARUM_ADMIN_MAIL=admin@example.com
# FLARUM_TITLE=My Flarum Forum

# 可选性能配置（不填则用镜像默认值）
# UPLOAD_MAX_SIZE=50M
# PHP_MEMORY_LIMIT=128M
# OPCACHE_MEMORY_LIMIT=128
# LOG_TO_STDOUT=true
